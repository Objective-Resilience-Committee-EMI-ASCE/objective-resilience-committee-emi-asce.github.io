---
import Default from '@astrojs/starlight/components/Footer.astro';
const d = Astro.locals.starlightRoute.entry.data;
const citations = (d.citation ?? []).filter((c) => c.trim());
const GITHUB = 'https://github.com/Objective-Resilience-Committee-EMI-ASCE/objective-resilience-committee-emi-asce.github.io';
---

{
  d.category && citations.length > 0 && (
    <section class="entry-citation">
      <h2 id="citation">Citation</h2>
      <p style="margin:0 0 0.5rem">If you use data or methods from this entry, please cite:</p>
      <ul>{citations.map((c) => <li>{c}</li>)}</ul>
    </section>
  )
}

<Default><slot /></Default>

<nav class="site-links" aria-label="Related links">
  <a href="https://www.asce.org/">ASCE</a>
  <a href="https://www.asce.org/communities/institutes-and-technical-groups/engineering-mechanics-institute/committees/board-of-governors--emi/objective-resilience-committee">EMI Objective Resilience Committee</a>
  <a href={GITHUB} class="gh">
